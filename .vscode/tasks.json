{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run proximity_fear.main.ProximityFear",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "windows": {
                "command": "${workspaceFolder}/.venv/Scripts/python.exe"
            },
            "args": [
                "-m",
                "jitx",
                "build",
                "proximity_fear.main.ProximityFear",
                "--port",
                "${command:jitx.get-websocket-port}"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build"
            },
            "detail": "JITX Build task"
        },
        {
            "label": "Run All JITX Designs in Project",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "windows": {
                "command": "${workspaceFolder}/.venv/Scripts/python.exe"
            },
            "args": [
                "-m",
                "jitx",
                "build-all",
                "--port",
                "${command:jitx.get-websocket-port}"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build"
            },
            "detail": "JITX Build task"
        }
    ]
}